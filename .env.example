# Real-Debrid (optional, unused)
RD_API_KEY=your_rd_api_key

# Simkl (required for auth + history + ratings)
SIMKL_CLIENT_ID=your_simkl_client_id

# TMDB (required for recommendations)
TMDB_API_KEY=your_tmdb_api_key

# Upstash Redis (required for Simkl token storage)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# Base URL (your Cloud Run URL)
BASE_URL=https://my-stremio-addon-981079721173.us-central1.run.app
